{
  "metadata": {
    "name": "medical_listing",
    "version": "1.0.0",
    "description": "医疗费用清单识别"
  },
  "server": {
    "api_base": "https://ai.inspirvision.cn/s",
    "timeout": 30
  },
  "tools": [
    {
      "name": "medical_listing",
      "description": "医疗费用清单识别",
      "category": "医疗票据识别",
      "http": {
        "method": "POST",
        "path": "/api/ocr/medicalListing",
        "content_type": "form-data"
      },
      "parameters": [
        {
          "python_name": "img_base64",
          "http_field": "imgBase64",
          "type": "string",
          "required": false,
          "default": "",
          "description": "图片base64编码",
          "location": "body"
        },
        {
          "python_name": "img_url",
          "http_field": "imgUrl",
          "type": "string",
          "required": false,
          "default": "",
          "description": "图片URL地址"
        },
        {
          "python_name": "province",
          "http_field": "province",
          "type": "string",
          "required": false,
          "default": "",
          "description": "省份名称",
          "location": "body"
        },
        {
          "python_name": "city",
          "http_field": "city",
          "type": "string",
          "required": false,
          "default": "",
          "description": "城市名称",
          "location": "body"
        },
        {
          "python_name": "kd_use_flag",
          "http_field": "kdUseFlag",
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "是否知识库匹配（0否 1是）",
          "location": "body"
        },
        {
          "python_name": "medical_type",
          "http_field": "medicalType",
          "type": "string",
          "required": false,
          "default": "",
          "description": "清单类型，不传自动识别",
          "location": "body"
        }
      ]
    }
  ]
}
{
  "metadata": {
    "name": "medical_knowledge",
    "version": "1.0.0",
    "description": "医疗知识库查询"
  },
  "server": {
    "api_base": "https://ai.inspirvision.cn/s",
    "timeout": 30
  },
  "tools": [
    {
      "name": "get_knowledge",
      "description": "医疗知识库查询",
      "category": "医疗票据识别",
      "http": {
        "method": "POST",
        "path": "/api/ocr/getKnowledge",
        "content_type": "form-data"
      },
      "parameters": [
        {
          "python_name": "query_name",
          "http_field": "queryName",
          "type": "string",
          "required": true,
          "default": "",
          "description": "查询名称（必填）",
          "location": "body"
        },
        {
          "python_name": "db_type",
          "http_field": "dbType",
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "查询类目（1=药品 2=耗材 3=医疗服务 4=医疗机构 5=手术 6=疾病），0=全部",
          "location": "body"
        },
        {
          "python_name": "accurate",
          "http_field": "accurate",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "是否精准查询（0否 1是）",
          "location": "body"
        },
        {
          "python_name": "province",
          "http_field": "province",
          "type": "string",
          "required": false,
          "default": "",
          "description": "省份，不传全国",
          "location": "body"
        },
        {
          "python_name": "city",
          "http_field": "city",
          "type": "string",
          "required": false,
          "default": "",
          "description": "城市，不传全国",
          "location": "body"
        },
        {
          "python_name": "top",
          "http_field": "top",
          "type": "integer",
          "required": false,
          "default": 5,
          "description": "返回条数 1-100，默认5",
          "location": "body"
        }
      ]
    }
  ]
}
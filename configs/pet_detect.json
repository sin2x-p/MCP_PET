{
  "metadata": {
    "name": "pet_detect",
    "version": "1.0.0",
    "description": "猫狗全身关键点识别"
  },
  "server": {
    "api_base": "https://ai.inspirvision.cn/s",
    "timeout": 30
  },
  "tools": [
    {
      "name": "pet_detect",
      "description": "猫狗全身关键点识别",
      "category": "宠物识别",
      "http": {
        "method": "POST",
        "path": "/api/petDetect",
        "content_type": "form-data"
      },
      "parameters": [
        {
          "python_name": "img_base64",
          "http_field": "imageBase64",
          "type": "string",
          "required": false,
          "default": "",
          "description": "图片base64编码(不能带data:image/png;base64头)，和图片地址必须传一个",
          "location": "body"
        },
        {
          "python_name": "image_url",
          "http_field": "imageUrl",
          "type": "string",
          "required": false,
          "default": "",
          "description": "图片URL地址，和图片base64编码必须传一个"
        }
      ]
    }
  ]
}
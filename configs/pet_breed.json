{
  "metadata": {
    "name": "pet_breed",
    "version": "1.0.0",
    "description": "宠物品种识别"
  },
  "server": {
    "api_base": "https://ai.inspirvision.cn/s",
    "timeout": 30
  },
  "tools": [
    {
      "name": "pet_type",
      "description": "宠物品种识别（识别猫/狗品种）",
      "category": "宠物识别",
      "http": {
        "method": "POST",
        "path": "/api/petType",
        "content_type": "form-data"
      },
      "parameters": [
        {
          "python_name": "img_base64",
          "http_field": "imageBase64",
          "type": "string",
          "required": false,
          "default": "",
          "description": "图片base64编码，和图片地址必须传一个",
          "location": "body"
        },
        {
          "python_name": "image_url",
          "http_field": "imageUrl",
          "type": "string",
          "required": false,
          "default": "",
          "description": "图片URL地址，和图片base64编码必须传一个"
        },
        {
          "python_name": "pet_type",
          "http_field": "petType",
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "宠物类别：0为狗 1为猫",
          "location": "body"
        },
        {
          "python_name": "top_k",
          "http_field": "topK",
          "type": "integer",
          "required": false,
          "default": 3,
          "description": "返回前K个品种，默认3，最大10",
          "location": "body"
        }
      ]
    }
  ]
}
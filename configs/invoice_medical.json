{
  "metadata": {
    "name": "invoice_medical",
    "version": "1.0.0",
    "description": "医疗票据识别"
  },
  "server": {
    "api_base": "https://ai.inspirvision.cn/s",
    "timeout": 30
  },
  "tools": [
    {
      "name": "invoice_check_all",
      "description": "医疗电子发票查验（兼容版）。支持传图片或发票信息进行查验。",
      "category": "医疗票据识别",
      "http": {
        "method": "POST",
        "path": "/api/ocr/invoiceCheckAll",
        "content_type": "form-data"
      },
      "parameters": [
        {
          "python_name": "invoice_code",
          "http_field": "invoiceCode",
          "type": "string",
          "required": false,
          "default": "",
          "description": "发票代码",
          "location": "body"
        },
        {
          "python_name": "invoice_number",
          "http_field": "invoiceNumber",
          "type": "string",
          "required": false,
          "default": "",
          "description": "发票号码",
          "location": "body"
        },
        {
          "python_name": "check_code",
          "http_field": "checkCode",
          "type": "string",
          "required": false,
          "default": "",
          "description": "校验码后6位",
          "location": "body"
        },
        {
          "python_name": "pretax_amount",
          "http_field": "pretaxAmount",
          "type": "string",
          "required": false,
          "default": "",
          "description": "发票金额",
          "location": "body"
        },
        {
          "python_name": "invoicing_date",
          "http_field": "invoicingDate",
          "type": "string",
          "required": false,
          "default": "",
          "description": "开票日期，如 20240118",
          "location": "body"
        },
        {
          "python_name": "payer",
          "http_field": "payer",
          "type": "string",
          "required": false,
          "default": "",
          "description": "交款人信息，一年以上票据必传",
          "location": "body"
        },
        {
          "python_name": "id_card_no",
          "http_field": "idCardNo",
          "type": "string",
          "required": false,
          "default": "",
          "description": "身份证后六位",
          "location": "body"
        },
        {
          "python_name": "need_pdf",
          "http_field": "needPdf",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "是否需要明细（0不需要 1需要，默认1）",
          "location": "body"
        },
        {
          "python_name": "img_base64",
          "http_field": "imgBase64",
          "type": "string",
          "required": false,
          "default": "",
          "description": "图片base64编码(含data:image/png;base64,)，与发票信息二选一",
          "location": "body"
        },
        {
          "python_name": "img_url",
          "http_field": "imgUrl",
          "type": "string",
          "required": false,
          "default": "",
          "description": "图片URL地址"
        }
      ]
    },

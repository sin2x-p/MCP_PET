# 指定mcp服务镜像
MCP_IMAGE=biz-mcp-gateway
MCP_NETWORK=mcp_default

# 指定nginx容器名
NGINX_CONTAINER=mcp-nginx-1

# 指定nginx.conf在宿主机上的路径
NGINX_CONF_HOST=E:\code\mcp\nginx.conf

# 指定nginx.conf在容器内的路径
NGINX_CONF_PATH=E:\code\mcp\nginx.conf

# 指定mcp服务配置文件地址
CONFIGS_DIR=E:\code\mcp\configs

# 指定docker-compose.yml文件路径
COMPOSE_PATH=E:\code\mcp\docker-compose.yml

# 管理平台端口
ADMIN_PORT=9001

# 指定mcp服务镜像
MCP_IMAGE=biz-mcp-gateway
MCP_NETWORK=mcp_default

# 指定nginx容器名
NGINX_CONTAINER=mcp-nginx-1

# 指定nginx.conf在容器内的路径（admin容器内写入用）
NGINX_CONF_PATH=/app/nginx.conf

# 指定mcp服务配置文件地址（容器内路径，用于admin读取生成compose/nginx）
CONFIGS_DIR=/app/configs

# 指定configs在宿主机上的路径（docker-compose volume用）
CONFIGS_HOST_DIR=/home/pxy/configs

# 指定docker-compose.yml文件路径（容器内路径）
COMPOSE_PATH=/app/docker-compose.yml

# 管理平台端口
ADMIN_PORT=9001
